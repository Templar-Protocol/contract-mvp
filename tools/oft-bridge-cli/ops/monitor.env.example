# Always promote a reviewed digest. Tags can be moved after review.
OFT_BRIDGE_IMAGE=ghcr.io/templar-protocol/oft-bridge-cli@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# One directory below OFT_ROUTES_DIR containing route.json and its logs.
OFT_ROUTE_NAME=mainnet-example

# Use absolute host paths. Compose refuses to create missing paths silently.
OFT_ROUTES_DIR=/srv/templar/oft/routes
OFT_OPERATIONS_DIR=/srv/templar/oft/operations

MONITOR_INTERVAL_SECONDS=60
# Keep this comfortably above the interval plus the expected check duration.
MONITOR_HEALTH_MAX_AGE_SECONDS=300
